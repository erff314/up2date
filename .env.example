# ==============================================================================
# Environment Configuration Template for up2date (Shared via Git)
# ==============================================================================
# Copy this file to .env and adjust the values:
#   cp .env.example .env
#
# DO NOT commit real secrets or production credentials into this file.
# ==============================================================================

# PostgreSQL Connection String (e.g., Supabase, Neon, or local PostgreSQL instance)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/up2date?schema=public"

# NextAuth / Auth Secret for session token signing (min 32 characters in production)
NEXTAUTH_SECRET="development-secret-change-me-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"
