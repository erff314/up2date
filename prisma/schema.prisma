// ==============================================================================
// Prisma Schema: Modular Digital Newspaper Platform ("up2date")
// Multi-Tenant Private Group Newspapers
// ==============================================================================
// This schema defines the database structure for our multi-tenant platform.
// All tables strictly scope data to a specific newspaper (tenant isolation).
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

/// Scoped roles for members within a specific private newspaper
enum Role {
  READER       // Can view published issues, stream podcasts, comment, view calendar
  PROOFREADER  // Reviews drafts, edits content, provides editorial feedback notes
  EDITOR       // Authors, edits, and finalizes/approves articles for publication
  ADMIN        // Manages newspaper settings, members, role assignments & module toggles
}

/// Editorial publication lifecycle for an article
enum ArticleStatus {
  DRAFT        // Initial draft authored by an Editor
  IN_REVIEW    // Under review with inline feedback by a Proofreader
  APPROVED     // Revisions completed and approved by an Editor
  PUBLISHED    // Live for newspaper members on the private frontpage
}

/// Categories for interactive team calendar events
enum EventCategory {
  DEADLINE     // Editorial deadlines (e.g., article submission cutoff)
  BIRTHDAY     // Member birthdays & personal milestones
  EVENT        // General meetings, social gatherings, club events
}

// ------------------------------------------------------------------------------
// AUTHENTICATION & CORE USER MODEL
// ------------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relationships
  memberships  NewspaperMember[]  // Newspapers this user belongs to (with scoped roles)
  articles     Article[]          // Articles written by this user
  revisions    ArticleRevision[]  // Proofreading reviews & feedback left by this user
  comments     Comment[]          // Comments posted by this user

  @@index([email])
}

// ------------------------------------------------------------------------------
// MULTI-TENANT NEWSPAPER & MEMBERSHIP
// ------------------------------------------------------------------------------

/// Represents an individual private digital newspaper instance (Tenant)
model Newspaper {
  id          String   @id @default(cuid())
  name        String   // Display title (e.g. "FC Vorwärts Vereinsbote")
  slug        String   @unique // URL identifier (e.g. "fc-vorwaerts")
  description String?  // Short bio/motto of the newspaper
  logoUrl     String?  // Custom branding logo
  inviteCode  String   @unique @default(cuid()) // Secret code to join this private newspaper
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Tenant-isolated entities
  members      NewspaperMember[]
  articles     Article[]
  events       CalendarEvent[]
  podcasts     PodcastEpisode[]
  moduleConfig NewspaperModuleConfig?

  @@index([slug])
}

/// Links a User to a specific Newspaper with an explicit tenant-scoped Role
model NewspaperMember {
  id          String    @id @default(cuid())
  newspaperId String
  userId      String
  role        Role      @default(READER)
  joinedAt    DateTime  @default(now())

  newspaper   Newspaper @relation(fields: [newspaperId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newspaperId, userId]) // A user has exactly one primary role per newspaper
  @@index([newspaperId])
  @@index([userId])
}

/// Dynamic on/off feature module toggles per newspaper instance (FORM-04 Admin Panel)
model NewspaperModuleConfig {
  id          String    @id @default(cuid())
  newspaperId String    @unique
  hasPodcast  Boolean   @default(true)  // Podcast Player & Archive module
  hasCalendar Boolean   @default(true)  // Event Calendar module
  hasMap      Boolean   @default(true)  // Live Reporter Map module
  hasPdfExport Boolean  @default(true)  // Print-ready PDF Generator module
  hasGallery  Boolean   @default(true)  // Lightbox Photo Gallery module
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  newspaper   Newspaper @relation(fields: [newspaperId], references: [id], onDelete: Cascade)
}

// ------------------------------------------------------------------------------
// EDITORIAL CONTENT & ARTICLES (FORM-02 & FORM-03)
// ------------------------------------------------------------------------------

/// Digital newspaper article with editorial lifecycle
model Article {
  id          String        @id @default(cuid())
  newspaperId String
  authorId    String
  title       String
  slug        String
  excerpt     String?       // Short summary/lead paragraph
  content     String        // Structured rich-text body (TipTap JSON or HTML string)
  coverImage  String?       // Hero header image URL
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  newspaper   Newspaper     @relation(fields: [newspaperId], references: [id], onDelete: Cascade)
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  revisions   ArticleRevision[]
  comments    Comment[]

  @@unique([newspaperId, slug]) // Slugs must be unique within a single newspaper
  @@index([newspaperId, status])
  @@index([authorId])
}

/// Revision history and proofreader notes for quality control (FORM-03)
model ArticleRevision {
  id             String   @id @default(cuid())
  articleId      String
  reviewerId     String
  content        String   // Snapshot of the article content at this revision
  editorialNotes String?  // Feedback/corrections provided by the Proofreader
  createdAt      DateTime @default(now())

  article        Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  reviewer       User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([reviewerId])
}

// ------------------------------------------------------------------------------
// FEATURE MODULES DATA (FORM-05, FORM-06, FORM-07)
// ------------------------------------------------------------------------------

/// Member comments below published articles (FORM-06 Interaction Center)
model Comment {
  id        String   @id @default(cuid())
  articleId String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([authorId])
}

/// Calendar events for team coordination (FORM-07 Calendar Manager)
model CalendarEvent {
  id          String        @id @default(cuid())
  newspaperId String
  title       String
  description String?
  category    EventCategory @default(EVENT)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime      @default(now())

  newspaper   Newspaper     @relation(fields: [newspaperId], references: [id], onDelete: Cascade)

  @@index([newspaperId, startDate])
}

/// Podcast episodes with audio file and show notes (FORM-05 Podcast Uploader)
model PodcastEpisode {
  id          String   @id @default(cuid())
  newspaperId String
  title       String
  description String?
  audioUrl    String   // Path or URL to the MP3 file
  duration    Int?     // Duration in seconds
  showNotes   String?  // Additional links/timestamps
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  newspaper   Newspaper @relation(fields: [newspaperId], references: [id], onDelete: Cascade)

  @@index([newspaperId, publishedAt])
}
